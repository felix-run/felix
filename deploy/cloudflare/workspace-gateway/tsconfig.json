{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Runtime types generated by `npm run types` for this Worker's compatibility date: the
    // Container API (`exec`, `images`, `setInactivityTimeout`) is newer than any
    // @cloudflare/workers-types release pinned elsewhere.
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src", "tests", "worker-configuration.d.ts"]
}
