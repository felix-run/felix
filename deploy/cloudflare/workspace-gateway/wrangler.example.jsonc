// The workspace gateway. Copy to wrangler.jsonc (gitignored) for a real deployment.
// The harness's bearer is a secret, never a var:
//   wrangler secret put WORKSPACE_GATEWAY_TOKEN     # 32+ characters, e.g. `openssl rand -hex 32`
// and the same value goes into the harness as FELIX_WORKSPACE_GATEWAY_TOKEN.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felix-workspace-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Each scope's /workspace, one object per backup, under workspaces/. Create it first:
  //   wrangler r2 bucket create felix-workspaces
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "felix-workspaces" }],
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "WorkspaceSandbox" }]
  },
  "containers": [
    {
      "class_name": "WorkspaceSandbox",
      "scheduling_policy": "durable_object",
      "images": { "workspace": { "dockerfile": "./Dockerfile" } }
    }
  ],
  // Each sandbox's size, passed to ctx.container.start() (the `durable_object` policy takes no
  // `instance_type` here): lite, standard-1 (the default), standard-2, standard-3 or standard-4.
  // `lite` is 1/16 vCPU and 256 MiB, too little for git over a repository or a package install.
  "vars": { "WORKSPACE_INSTANCE": "standard-1" },
  "exports": {
    "WorkspaceSandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
