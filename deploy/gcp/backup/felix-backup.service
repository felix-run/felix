[Unit]
Description=Felix nightly backup (Postgres + object store, copied to GCS)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/felix-backup
ExecStart=/usr/local/sbin/felix-backup
Nice=10
IOSchedulingClass=idle
