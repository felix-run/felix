# Felix environment — copy to .env and fill secrets.
# Generate secrets with: openssl rand -hex 32

# --- runtime ---
FELIX_ENVIRONMENT=development
# Loopback by default. FELIX_AUTH_MODE=none is refused on any other bind, because an
# unauthenticated API reachable off-host exposes PUT /manifests to anyone who can route
# to it. Containers set 0.0.0.0 explicitly and pair it with a real auth mode.
FELIX_HOST=127.0.0.1
FELIX_PORT=8080
FELIX_LOG_LEVEL=INFO
# auto = JSON in production, readable text elsewhere. Every line carries request_id,
# tenant_id and (when OTel is on) trace_id.
# FELIX_LOG_FORMAT=auto
# Only relevant for a non-development environment; it does NOT permit a public bind.
FELIX_ALLOW_INSECURE=true

# --- auth (none | api_key | jwt) ---
# `none` is a loopback-only local-dev mode. `make up` generates an api_key for you.
FELIX_AUTH_MODE=none
# FELIX_AUTH_API_KEYS={"sk-demo":{"tenant_id":"default","sub":"demo","scopes":["audit:read","manifests:write"]}}
# FELIX_JWT_VERIFIERS=self:felix-self   # accepts what `felix mint-jwt` and GitHub login sign
# FELIX_JWKS_PUBLIC=   # PEM or JWKS JSON — the public half of FELIX_JWKS_PRIVATE
# FELIX_JWKS_PRIVATE=  # RSA PEM for minting — openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Tenants a JWT may claim (comma-separated). Empty accepts any claimed tenant,
# which is only safe when the IdP is the sole writer of that claim — on Cognito
# `custom:*` attributes are often user-writable.
FELIX_ALLOWED_TENANTS=
# GitHub login: device flow, then a self-issued JWT for the tenant of the user's org.
# Off while the client id is empty. Needs FELIX_AUTH_MODE=jwt, a self:felix-self verifier
# (tenant=claim) and FELIX_JWKS_PRIVATE; boot fails if a minted token would not verify.
# The OAuth app needs "Enable Device Flow"; an org with OAuth app restrictions must approve it.
FELIX_GITHUB_CLIENT_ID=
# {"<org>": {"id": <numeric org id>, "tenant": "<tenant id>", "scopes": ["manifests:write", ...]}}
# Active members only. `id` (gh api orgs/<org> --jq .id) pins the org: a name can be re-registered.
FELIX_GITHUB_ORG_TENANTS=
FELIX_GITHUB_LOGIN_TTL_SECONDS=28800   # max 86400: there is no revocation before expiry
FELIX_GITHUB_TIMEOUT_SECONDS=10
# Per client address (an IPv6 client is its /64): each start spends from the OAuth app's
# GitHub quota. The total caps the whole deployment, since a botnet is many clients. Reaching
# it refuses every new login until the hour turns (issued tokens are unaffected), so size it
# to your login volume. Without FELIX_REDIS_URL both buckets are per process.
FELIX_GITHUB_DEVICE_STARTS_PER_HOUR=10
# GitHub Actions login: POST /auth/github/actions trades a workflow's OIDC token
# (permissions: id-token: write) for a Felix token, so CI holds no stored secret. Off while
# empty. The audience the workflow requests: this deployment's own https URL, never a github.com
# one. Each org that allows it adds an `actions` block to its FELIX_GITHUB_ORG_TENANTS entry:
#   "actions": {"repositories": {"deploy": <repo id>}, "refs": ["refs/heads/main"],
#               "scopes": ["manifests:write"]}
# Repositories are names inside the org mapped to their numeric id (gh api repos/<org>/<name>
# --jq .id). At least one of `refs`, `workflows` (job_workflow_ref globs) or `environments` is
# required. pull_request_target, issue_comment and workflow_run are refused unless listed in
# `events`. deploy/GOVERNANCE.md#github-login has the threat model.
FELIX_GITHUB_OIDC_AUDIENCE=
FELIX_GITHUB_OIDC_TTL_SECONDS=900   # max 3600
FELIX_GITHUB_DEVICE_STARTS_PER_HOUR_TOTAL=300
# Browser sign-in by redirect, through a GitHub App (FELIX_GITHUB_CLIENT_ID is then the App's
# client id). On while all three below are set. The token key is 32 bytes, base64
# (`openssl rand -base64 32`); it seals the sign-in cookies and each person's stored GitHub tokens.
FELIX_GITHUB_CLIENT_SECRET=
FELIX_GITHUB_TOKEN_KEY=
FELIX_GITHUB_REDIRECT_ORIGINS=
# The callback path as the browser sees it; behind chat-ui's proxy it carries `/api`.
FELIX_GITHUB_CALLBACK_PATH=/api/auth/github/callback
# The GitHub App's slug (github.com/apps/<slug>): lets clients link to installing it on more repos.
FELIX_GITHUB_APP_SLUG=
# Signup: a GitHub account in none of the orgs above gets a personal tenant, gh-<GitHub id>.
# off (default) admits nobody that way; invite admits only the accounts listed, each `login` or
# `login:<id>` (gh api users/<login> --jq .id; pinned, a renamed account keeps its invite and a
# re-registered login does not inherit it). There is no `open`: nothing caps a tenant's spend yet.
# Scopes are required while signup is on, and may not include admin or *.
FELIX_GITHUB_SIGNUP=off
FELIX_GITHUB_SIGNUP_LOGINS=
FELIX_GITHUB_SIGNUP_SCOPES=
# Per-person repos: a thread's checkout. Empty root = FELIX_DATA_DIR/checkouts; never under
# FELIX_WORKSPACE_ROOT. API and worker must share it.
FELIX_REPO_CHECKOUT_ROOT=
FELIX_REPO_CLONE_MAX_MB=500
FELIX_REPO_CHECKOUT_TTL_DAYS=14
FELIX_REPO_CLONE_TIMEOUT_SECONDS=600

# --- HTTP posture ---
# /docs and /openapi.json are behind auth in api_key and jwt modes (they describe every
# route). A browser cannot send the API credential, so reach the reference through an
# authenticating proxy in front of the origin, or set true to serve it anonymously
# (warned at startup outside development).
# FELIX_DOCS_PUBLIC=false
# HSTS on TLS responses only (seconds; 0 disables). The API sets nosniff, DENY, a
# no-referrer policy and no-store on every response, and a CSP on the docs page.
# includeSubDomains pins every sibling of the hostname for the whole max-age; on an
# apex or shared parent hostname turn it off before the first TLS response.
# FELIX_HSTS_MAX_AGE_SECONDS=15552000
# FELIX_HSTS_INCLUDE_SUBDOMAINS=true

# --- request limits ---
# Requests per window per client, applied *before* authentication so failed
# credentials are throttled too. Uses Redis when FELIX_REDIS_URL is reachable,
# degrading to per-process limits (with a loud log) if it is not.
FELIX_RATE_LIMIT=120
FELIX_RATE_LIMIT_WINDOW_SECONDS=60
# How long a POST /chat response is replayable under its Idempotency-Key (seconds).
# FELIX_IDEMPOTENCY_TTL_SECONDS=86400
# Header carrying the real client IP behind a proxy you operate, e.g.
# cf-connecting-ip or x-forwarded-for. EMPTY by default: the header is
# attacker-controlled unless your proxy overwrites it, and trusting it blindly
# lets one client present as unlimited distinct clients.
FELIX_TRUSTED_CLIENT_IP_HEADER=
# Proxies you operate that append to that header. The client is counted from the
# right: the last entry with one proxy, the one before it with two. The leftmost entry
# is whatever the client sent.
# FELIX_TRUSTED_PROXY_HOPS=1
# Commands that MCP stdio servers may spawn (comma-separated, exact match on the string
# the manifest supplies or its resolved absolute path). EMPTY = stdio disabled, which is
# the default: manifest-supplied argv is otherwise arbitrary code execution as the API
# process. Example: FELIX_MCP_STDIO_ALLOWED_COMMANDS=/usr/local/bin/uvx,/usr/bin/npx
FELIX_MCP_STDIO_ALLOWED_COMMANDS=
# Container images sandbox tools may run (comma-separated). `spec.sandboxes[].binding`
# is manifest-supplied and reaches `docker run`, so only the built-in
# python:3.14-slim is permitted unless you name more here.
FELIX_SANDBOX_ALLOWED_IMAGES=
# argv prefixes `spec.shell_tools` may exec on this host (comma-separated; tokens matched
# one for one from argv[0], so `git status` covers `git status --short` and not `git push`).
# EMPTY = shell tools disabled, which is the default. A manifest's prefixes must each be
# covered by one here. Example: FELIX_SHELL_ALLOWED_COMMANDS=uv run ruff,./scripts/test.sh,git status
FELIX_SHELL_ALLOWED_COMMANDS=
# Where shell tools exec. EMPTY = a child of the API process, as the API's user — code it runs
# can read the API's environment through /proc. Set it to a `felix-shell-runner` (the builder
# stack sets http://shell:8080, a container holding no secrets) and the API sends the argv there
# after its own checks; an unreachable runner fails the call, never falls back to a local exec.
FELIX_SHELL_RUNNER_URL=
# Bearer shared by the API and the runner; required (32+ characters) when the URL is set.
# `make up-self` generates one into .env (scripts/shell-runner-token.sh). openssl rand -hex 32
FELIX_SHELL_RUNNER_TOKEN=
# Required for POST /internal/* when auth_mode != none (or production):
# FELIX_CONSUMER_SHARED_SECRET=  # openssl rand -hex 32
# Signing secret for inbound webhooks; resolved through FELIX_SECRETS_BACKEND.
# FELIX_WEBHOOK_SECRET=          # openssl rand -hex 32
# Clients: header X-Felix-Consumer-Secret: <value>

# --- data plane (cloud-agnostic; AWS + GCP first) ---
# openssl rand -hex 32
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
FELIX_DATABASE_URL=postgresql+psycopg://felix:change-me-use-openssl-rand-hex-32@localhost:5432/felix
# Opt-in Postgres row-level security (sets app.tenant_id per transaction).
# Requires migration 0006_tenant_rls to be applied first.
# FELIX_DATABASE_RLS=false
# Required outside development (validate_runtime refuses an empty value): approvals,
# UI prompts and client-tool answers cross from the API to the worker through it. When it
# is configured but down, waiters, steer, thread notifications and session leases fall
# back to an in-process path and each logs a warning once — that fallback does not cross
# processes. Unset under FELIX_DATABASE_URL=memory://, the default localhost URL is not
# treated as a Redis: /ready, felix doctor and the rate limiter run without one. Set it
# (as below) and it is required on any database, so a down Redis fails /ready.
FELIX_REDIS_URL=redis://localhost:6379/0

# Connection pool, per worker process. The ceiling is size + overflow; past it,
# requests queue for FELIX_DB_POOL_TIMEOUT_SECONDS and then fail.
# FELIX_DB_POOL_SIZE=10
# FELIX_DB_MAX_OVERFLOW=20
# FELIX_DB_POOL_TIMEOUT_SECONDS=30
# A round trip per checkout to detect a connection a pooler closed server-side.
# Worth it behind PgBouncer / RDS Proxy / Cloud SQL; wasted against a direct Postgres.
# FELIX_DB_POOL_PRE_PING=true
# psycopg only. A connect to a blackholed host gives up after this many seconds instead
# of the OS default. Every connection presents application_name=felix-<role> to
# pg_stat_activity; each console script stamps its own role (api | worker | scheduler |
# cli) and this overrides it. There is no statement-timeout setting on
# purpose — a client-side one does not survive PgBouncer — set it on the role:
#   ALTER ROLE felix SET statement_timeout = '30s';   (felix doctor reports what applies)
# FELIX_DB_CONNECT_TIMEOUT_SECONDS=10
# FELIX_PROCESS_ROLE=
# Set false behind a transaction-mode pooler that does not track prepared statements
# itself. psycopg3 auto-prepares after five executions; under transaction pooling the
# sixth lands on a different server connection and fails. PgBouncer >= 1.21 with
# max_prepared_statements > 0 handles this for you; RDS Proxy pins the session instead,
# which defeats multiplexing, so turn this off there.
# FELIX_DB_PREPARED_STATEMENTS=true

# Granian/uvicorn worker processes. One process per core is the usual starting point;
# each carries its own connection pool, so raise this and the pool ceiling together.
# FELIX_WORKERS=1
# HTTP server: listen queue, async runtime threads per worker, how long a worker may
# finish in-flight requests (and flush its audit buffer) on SIGTERM before it is killed
# — the Helm chart sets this from the pod's grace period — and whether a worker that
# dies is respawned (a slow crash loop then shows only in Granian's log).
# FELIX_HTTP_BACKLOG=1024
# FELIX_HTTP_RUNTIME_THREADS=1
# FELIX_GRACEFUL_SHUTDOWN_SECONDS=120
# FELIX_RESPAWN_FAILED_WORKERS=true
# How long a Taskiq task result lives in Valkey/Redis; every cron tick writes one.
# FELIX_TASK_RESULT_TTL_SECONDS=3600

# Object store: s3 (AWS S3 / MinIO) | gcs (GCP) | fs (local dir, small VMs) | memory
FELIX_OBJECT_STORE=fs
# FELIX_OBJECT_STORE_PATH=   # optional; defaults to $FELIX_DATA_DIR/objects
FELIX_CLOUD_PROVIDER=local
# Secrets: env | file | aws | gcp
FELIX_SECRETS_BACKEND=env
# FELIX_SECRETS_DIR=./secrets
# Extra names resolved via backend for output masking (comma-separated)
# FELIX_SECRET_NAMES=
# FELIX_AWS_REGION=us-east-1
# FELIX_GCP_PROJECT=
# FELIX_GCS_BUCKET=

# Docker image extras (comma-separated): aws,gcp,otel,warehouse — leave empty for lean images
# FELIX_DOCKER_EXTRAS=
# Example DuckDB warehouse image: FELIX_DOCKER_EXTRAS=warehouse FELIX_WAREHOUSE=duckdb

# openssl rand -hex 32
MINIO_ROOT_USER=felix
MINIO_ROOT_PASSWORD=change-me-use-openssl-rand-hex-32
FELIX_S3_ENDPOINT=http://localhost:9000
FELIX_S3_ACCESS_KEY=felix
FELIX_S3_SECRET_KEY=change-me-use-openssl-rand-hex-32
FELIX_S3_BUCKET=felix-bundles
FELIX_S3_REGION=us-east-1

# --- models ---
# Cloud keys (optional). Prefer real provider keys — not LangSmith/tracing tokens.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FELIX_ANTHROPIC_API_KEY=
FELIX_OPENAI_API_KEY=
# FELIX_LITELLM_BASE_URL=
FELIX_DEFAULT_MODEL_ID=claude-sonnet
# Route for turns that carry an image when the agent's model is text-only (gpt-oss, GLM Flash).
# Unset, such a turn is refused with a 422 naming the route. A manifest's spec.model.vision_model
# overrides it.
# FELIX_DEFAULT_VISION_MODEL_ID=
# FELIX_MODEL_ROUTES=
# Per-provider endpoint and credential, as JSON. The built-in providers have the named
# settings above; a provider added by a plugin cannot, because Settings ignores unknown
# env vars — so this is how an installed provider is given a key at all. An entry here
# also overrides the named field, which is how you point a built-in somewhere else:
#   FELIX_MODEL_PROVIDER_OPTIONS={"anthropic":{"base_url":"https://gateway.internal/v1"}}
# Every option value is masked out of tool output except the ones the provider consumes as
# addressing (base_url, endpoint placeholders, header options), so a credential is redacted
# whatever it is called — and an unrecognised option is redacted too. Do not put a
# credential in base_url: it is exempt by definition and also reaches logs on a connect error.
#   FELIX_MODEL_PROVIDER_OPTIONS={"groq":{"api_key":"gsk_..."}}
# Cloudflare Workers AI puts the account id in the URL path, so it is required; a
# gateway_id is optional and routes the same request through AI Gateway:
#   FELIX_MODEL_PROVIDER_OPTIONS={"workers_ai":{"api_key":"...","account_id":"...","gateway_id":"default"}}
# With that one entry, every built-in `-cf` route resolves, and so do the legacy llama-3-pro
# and llama-3-fast ids. All of them are priced, so limits.max_cost_usd holds on them; the
# README's routes table lists them and which need the Workers Paid plan. To run on open
# weights wherever a manifest names no model:
#   FELIX_DEFAULT_MODEL_ID=glm-5.3-cf
#   FELIX_MEMORY_EMBEDDER=workers_ai   # @cf/baai/bge-base-en-v1.5, the same model as the local default
# Any other Workers AI model is one route away; one the catalog does not price needs
# spec.model.price before a manifest can declare limits.max_cost_usd on it:
#   FELIX_MODEL_ROUTES={"scout-cf":{"provider":"workers_ai","model":"@cf/meta/llama-4-scout-17b-16e-instruct"}}
# FELIX_MODEL_PROVIDER_OPTIONS=
# Decision models answer typed questions (choose one, score, true/false) with calibrated
# probabilities instead of generating text; a manifest selects one with `spec.decider.id`.
# Built in: `clef` and `clef-flash` (Cloudflare's, on Workers AI) and `jev-cf` (Jev on Workers
# AI), all sharing the "workers_ai" entry above; `jev` (TypeSafe, key under "typesafe").
# `llm` decides with any FELIX_MODEL_ROUTES id instead:
#   FELIX_MODEL_PROVIDER_OPTIONS={"typesafe":{"api_key":"..."}}
#   FELIX_DECISION_ROUTES={"haiku-decider":{"provider":"llm","model":"claude-haiku"}}
# FELIX_DECISION_ROUTES=
# Bounds each HTTP request to a model provider. A large tool call — a file's contents as an
# argument — can legitimately take longer than the 120s default, and when it does the request
# fails and takes the run with it. On a streaming call it bounds the gap between chunks, not
# the whole turn. Read and write timeouts are not retried: a retry waits out the identical
# ceiling on identical input. Connect is pinned at 10s and does not scale with this.
# FELIX_MODEL_TIMEOUT_SECONDS=120

# --- durability ---
# Fibers are the one durable backend; `temporal` was removed and now fails startup.
FELIX_DURABILITY=fibers
# A fiber step that keeps raising (a store down, a save that cannot land) retries with
# doubling backoff (1m, 2m, 4m, 8m …, capped at 1h) and is marked `dead` after this many
# consecutive failures — fifteen minutes after the first, at the default.
# FELIX_FIBER_MAX_ATTEMPTS=5
# How often each worker checks for durable runs to start or resume (seconds; 0 = only the
# once-a-minute cron sweep), and how many fibers one worker advances at once.
# FELIX_FIBER_POLL_SECONDS=1.0
# FELIX_FIBER_CONCURRENCY=8
# Completion webhooks: endpoints a durable run may be announced to when it finishes, named by id
# in a manifest's `spec.execution.webhooks` (a manifest never carries a URL). The worker delivers
# each as a Standard Webhooks POST signed with `secret` (HMAC-SHA256; a `whsec_` key or any string;
# `secret:NAME` resolves through FELIX_SECRETS_BACKEND). `tenants` is required: the tenant ids that
# may name the endpoint, or "*" for every tenant — a receiver shared by all tenants must still
# check the payload's `tenant_id`, since each of them can produce runs signed with its secret.
# `private: true` lets it resolve to a private address, which the egress guard otherwise refuses.
#   FELIX_WEBHOOK_ENDPOINTS={"ops":{"url":"https://hooks.example.com/felix","secret":"secret:OPS_WEBHOOK","tenants":["acme"]}}
# FELIX_WEBHOOK_ENDPOINTS=
# Tries per endpoint before a delivery is `dead` (backoff 1m, 2m, 4m … up to 1h), and the
# per-request timeout in seconds (at most 60: a sweep stops starting deliveries after 60 s).
# FELIX_WEBHOOK_MAX_ATTEMPTS=8
# FELIX_WEBHOOK_TIMEOUT_SECONDS=10

# Web Push: wake a subscribed browser (an installed phone app, a backgrounded tab) when a run
# is waiting on a person. Off until the key and subject are both set. Generate a key pair with
# any VAPID tool (e.g. `npx web-push generate-vapid-keys`) and set the *private* key here; the
# public key is derived from it and served at GET /push/vapid-public-key.
# A secret: ref is read once per process: restart after rotating it.
# FELIX_PUSH_VAPID_PRIVATE_KEY=secret:FELIX_PUSH_VAPID_PRIVATE_KEY
# FELIX_PUSH_VAPID_SUBJECT=mailto:ops@example.com
# FELIX_PUSH_ALLOWED_HOSTS=web.push.apple.com,*.push.apple.com,fcm.googleapis.com,updates.push.services.mozilla.com,*.notify.windows.com
# FELIX_PUSH_TIMEOUT_SECONDS=10
# Durable chats (spec.execution.mode: durable) run as fibers in felix-worker.

# --- retention (worker retention_sweep, nightly at 03:00) ---
# Days a row is kept; 0 keeps forever. audit_events, usage_events, fibers + a2a_tasks
# (terminal rows only), and session_events (whole threads, off by default: the event log
# is the chat record). A manifest's governance.retention_days shortens the audit TTL for
# its own rows and never extends it.
# FELIX_AUDIT_RETENTION_DAYS=30
# FELIX_USAGE_RETENTION_DAYS=365
# FELIX_FIBER_RETENTION_DAYS=7
# FELIX_SESSION_RETENTION_DAYS=0
# Settled approvals only -- a grant that can still authorize a call is never swept,
# however old. 0 keeps every row, because an approval is the record of a human
# decision and the soc2 / eu_ai_act profiles lean on it.
# FELIX_APPROVAL_RETENTION_DAYS=0

# --- scale-out (multiple api/worker replicas) ---
# Requires Postgres and a shared object store (s3 | gcs | fs on shared storage);
# Settings.validate_runtime() rejects memory/sqlite when this is on.
# FELIX_SCALE_OUT=false
# Names this process in fiber lease rows and log lines. `durability/fibers.py` compares it
# against a claim's `lease_owner` to decide whether the claim is its own, so it must differ
# between replicas -- two workers sharing a name match each other's claims. Defaults to
# `{hostname}:{pid}`, which is already distinct per process; the Helm chart sets it to the
# pod name. Set it only if you want a name of your own, and never to an empty value.
# FELIX_REPLICA_ID=worker-a

# --- analytics warehouse (append-only spill; Postgres is system of record) ---
# Lean default: none. Recommended: duckdb (uv sync --extra warehouse).
# Scale-out: clickhouse (uv sync --extra warehouse-clickhouse).
# Alternative: doris only if you already run Apache Doris (warehouse-doris).
FELIX_WAREHOUSE=none
# FELIX_WAREHOUSE_PATH=   # duckdb file; default $FELIX_DATA_DIR/warehouse/felix.duckdb
# FELIX_WAREHOUSE_URL=    # clickhouse http://host:8123 | doris mysql://user:pass@host:9030
# FELIX_WAREHOUSE_DATABASE=felix

# --- long-term memory ---
# Dimension of the memory_vectors.embedding pgvector column (HNSW-indexed).
# Fixed at deploy time: changing it is a re-embed of every stored memory, not a
# config flip. Must match whatever embedding model you configure.
# FELIX_MEMORY_EMBEDDING_DIM=768
# Semantic recall backend. `auto` (default) embeds locally with the bge model when
# felix-harness[embeddings] is installed (weights fetched on first use) and otherwise
# runs recall on its full-text and topic-key channels alone. Local only: a hosted
# embedder sends every stored memory to that provider, so it is always explicit.
# FELIX_MEMORY_EMBEDDER=auto          # auto | none | sentence_transformers | or any registered
#   model provider that serves it (openai, workers_ai, google) — /embeddings is part
#   of the same wire format, and resolves through the same provider descriptor.

# --- Web search -------------------------------------------------------------
# Off by default. Search reaches an endpoint you run or pay for, so a deployment
# should not acquire it by upgrading. `searxng` is bundled because it is
# self-hostable and needs no account; anything else is a plugin
# (felix.search.register_search_backend). A manifest opts in with
# spec.search_tools; without a backend the tool binds and reports it is unset,
# rather than silently doing nothing.
# FELIX_SEARCH_BACKEND=none           # none | searxng | any registered backend
# FELIX_SEARCH_URL=                   # e.g. https://searx.example.com — still
#   validated by the egress guard, so an instance in private space is refused.
# FELIX_SEARCH_API_KEY=               # only if your instance requires one
# FELIX_SEARCH_TIMEOUT_SECONDS=15

# --- Attachments ------------------------------------------------------------
# Per-tenant ceiling on stored upload bytes for `/files`. MAX_ATTACHMENT_BYTES
# caps one upload; this caps the total. Bytes rather than a count because the
# resource is disk, and on the default fs backend the object store shares it
# with artifact spill and manifest storage. 0 disables the ceiling.
# FELIX_ATTACHMENTS_MAX_BYTES_PER_TENANT=268435456

# How long a stored upload is kept before the nightly sweep drops it and its
# bytes. 0 keeps forever, which is the default: an attachment is caller data,
# and a thread can still reference one long after it was uploaded.
# FELIX_ATTACHMENT_RETENTION_DAYS=0

# How long a spilled tool output (spec.artifacts) is kept before the nightly
# sweep drops it. Unlike uploads this defaults to a bound: a spill is the
# harness's working copy, and five bundled manifests spill by default. Past it,
# read_artifact, GET /artifacts and the terminal's /artifact report it missing.
# 0 keeps forever.
# FELIX_ARTIFACT_RETENTION_DAYS=30

# --- Document corpus --------------------------------------------------------
# Per-tenant document ceiling for `/documents`. Nothing else caps how many
# documents a `documents:write` credential may ingest — the other limits bound
# one request and one document, not the corpus.
# FELIX_DOCUMENTS_MAX_PER_TENANT=5000

# Extra directory of SKILL.md packages, searched alongside the bundled skills/ dir.
# FELIX_SKILLS_DIR=/opt/felix/skills
# Publish gate for the tenant skill library. A version whose security scan fails never
# publishes; these raise the bar further. Quality is the 0-100 review score (0 = no bar).
# FELIX_SKILL_PUBLISH_MIN_QUALITY=0
# Also refuse a version whose scan is advisory (medium findings only).
# FELIX_SKILL_PUBLISH_BLOCK_ON_ADVISORY=false
# Require a succeeded evaluation before any publish, and optionally a minimum uplift (-100..100).
# FELIX_SKILL_PUBLISH_REQUIRE_EVAL=false
# FELIX_SKILL_PUBLISH_MIN_EVAL_UPLIFT=
# A tenant can tighten all four with PATCH /skill-library/-/policy, never loosen them.
# Model routes for the skill quality loop (FELIX_MODEL_ROUTES ids; empty = the default route):
# the rewrite from accepted feedback, which always lands as a draft for review...
# FELIX_SKILL_IMPROVE_MODEL=
# ...and the evaluation: the model that answers each scenario with and without the skill,
# the judge that scores both answers 0-100, and how many scenarios one evaluation runs (1-10).
# FELIX_SKILL_EVAL_MODEL=
# FELIX_SKILL_EVAL_JUDGE_MODEL=
# FELIX_SKILL_EVAL_MAX_SCENARIOS=10
# Output tokens per call: each answer, generated scenario list and judge score; and the rewrite.
# FELIX_SKILL_EVAL_MAX_TOKENS=2048
# FELIX_SKILL_IMPROVE_MAX_TOKENS=8192
# Wall-clock limit on one improvement or evaluation; past it the job ends failed.
# FELIX_SKILL_JOB_DEADLINE_SECONDS=1200
# Per tenant: skill jobs (evaluations, accepted improvements) queued or running at once, and
# created per UTC day. Past either, queueing another answers 429 skill_jobs_cap_reached.
# FELIX_SKILL_JOBS_MAX_QUEUED=20
# FELIX_SKILL_JOBS_DAILY_LIMIT=200
# Importing skills from GitHub (POST /skill-library/-/import, `felix skills add`). Every import
# lands as a draft and publishes through the same gate, with advisory scans always blocking.
# A token reaches private repositories and lifts GitHub's anonymous rate limit (60 calls/hour);
# it is sent only to api.github.com. Read-only contents access is all it needs.
# FELIX_SKILL_IMPORT_GITHUB_TOKEN=
# Comma-separated [<tenant>=]github:<owner>[/<repo>[/<path>]] globs over the sources a browse or
# an import may name; an entry with a tenant applies to that tenant only. Empty allows any GitHub
# source. An entry without a glob allows that repository (or path) and everything under it.
# With FELIX_SKILL_IMPORT_GITHUB_TOKEN set, boot refuses -- unless FELIX_AUTH_MODE=none in
# development -- an empty list, an entry with no tenant, and an entry whose owner is a glob:
# each would let every tenant read whatever the token reads.
# FELIX_SKILL_IMPORT_SOURCES=acme=github:acme/*,acme=github:anthropics/skills,globex=github:globex/skills
# Minimum time, in days, since this tenant first saw a skill's exact files (on a browse or an
# import attempt) before they may be imported (0 = off, max 365): a cooldown so a compromised
# upstream commit can be noticed first. Counted from Felix's own first sighting, never from a
# commit date, which the pusher sets. A refused import saves nothing (403 too_recent). Tenants
# can raise it, never lower it.
# FELIX_SKILL_IMPORT_MIN_AGE_DAYS=0
# GitHub calls browses and imports may make per hour: one tenant's, and the whole deployment's
# (429 rate_limited past either). Charged per call; a 50-skill browse is 53 calls (54 when it
# names a bare branch or tag, which is looked up as both).
# FELIX_SKILL_IMPORT_CALLS_PER_HOUR=500
# FELIX_SKILL_IMPORT_CALLS_PER_HOUR_TOTAL=4000
# Check every imported skill against its origin this often, in hours, from the worker (0 = off,
# max 168). Records whether an update is waiting (GET /skill-library/-/upstream?refresh=false and
# the library detail read it without asking GitHub) and stamps the sighting the cooldown counts
# from, so a skill's clock starts without anyone asking. Spends at most half of each hourly
# budget above; needs felix-scheduler running.
# FELIX_SKILL_IMPORT_CHECK_HOURS=0
# Announce an imported skill's upstream change to a tenant's webhook: comma-separated
# tenant=endpoint_id, each id a FELIX_WEBHOOK_ENDPOINTS endpoint whose `tenants` includes that
# tenant (boot is refused otherwise). No wildcard; a tenant not listed gets nothing. Any recorded
# check (the sweep above, a check of the stored ref, the listing) that finds a digest the skill's
# newest version lacks queues one signed `skill.update_available` per digest -- metadata only,
# never file content -- and the worker sends it with the same signing and retries as run webhooks.
#   FELIX_SKILL_UPDATE_WEBHOOKS=acme=ops,acme=ci,beta=beta-hook
# FELIX_SKILL_UPDATE_WEBHOOKS=
# FELIX_MEMORY_EMBEDDING_MODEL=bge-base-en-v1.5
# FELIX_MEMORY_RECALL_LIMIT=8

# --- SSE reconnect ---
# `GET /chat/stream/{thread_id}` tails the session log so a client can reattach after
# a dropped stream. Idle connections close after this long; the client reconnects with
# its Last-Event-ID and loses nothing.
# FELIX_STREAM_RESUME_IDLE_SECONDS=300
# FELIX_STREAM_RESUME_POLL_SECONDS=1
# Ceiling the resume poll decays to after a stream has been quiet for a while. The
# first 30s stay at the floor above, so reattach latency is unaffected.
# FELIX_STREAM_RESUME_POLL_MAX_SECONDS=10

# --- session leases ---
# advisory: the routes that drive a thread check X-Felix-Lease-Token only when a client
# sends it. strict: a driving request without the header is 409 lease_held while another
# holder has the thread exclusively (an unheld or observer-only thread still passes), and
# /v1/chat/completions with a `user` -- the same thread -- is checked too.
# FELIX_LEASE_ENFORCE=advisory

# --- misc ---
FELIX_DEFAULT_MANIFEST=quick
# Where manifests may come from. `store` (default): tenant Postgres version, then the
# bundled YAML, with the write API mounted. `bundled`: only the files baked into the image,
# and the write routes are not registered at all — absent from the app and from
# /openapi.json rather than present and refusing. Flipping an existing deployment drops
# per-tenant auth.inbound tightening and 409s pin_compile threads once; see the README.
# FELIX_MANIFEST_SOURCE=store
FELIX_DATA_DIR=./data
# Optional workspace for AGENTS.md / SYSTEM.md / instruction files. Also the root the
# workspace file tools (list_dir/read_file/write_file/search_files) are confined to — the
# `contributor` manifest points this at a Felix checkout so the agent can edit it.
# FELIX_WORKSPACE_ROOT=.
# A manifest's `spec.workspace.scope` picks a directory under that root: its thread's (the
# default), its tenant's, or -- `deployment` -- the root itself, which holds every other scope
# and so is honoured only for these tenants (comma-separated; the operator's own).
# FELIX_WORKSPACE_DEPLOYMENT_TENANTS=default
# Where thread and tenant workspaces live: `local` (under FELIX_WORKSPACE_ROOT, the default) or
# `hosted` (each scope in its own sandbox, through the gateway Worker in
# deploy/cloudflare/workspace-gateway: its https URL, and the token set there as
# WORKSPACE_GATEWAY_TOKEN, 32+ characters). Under `hosted`, shell tools, image `path`,
# publish_commits and repository checkouts are refused outside `deployment` scope.
# FELIX_WORKSPACE_BACKEND=local
# FELIX_WORKSPACE_GATEWAY_URL=
# FELIX_WORKSPACE_GATEWAY_TOKEN=
# FELIX_LOAD_AGENTS_MD=false
# Not a FELIX_ setting: manifests resolve `auth: secret:NAME` through FELIX_SECRETS_BACKEND,
# and the default env backend reads the bare variable. The `contributor` manifest's GitHub
# MCP server wants a fine-grained PAT scoped to the one repository it may open PRs against
# (Contents: write, Pull requests: write).
# GITHUB_MCP_TOKEN=
FELIX_HIBERNATE_AFTER_SECONDS=300
# How often each process drains its audit/usage buffers to Postgres. The agent
# loop emits from the API process, so the API flushes too — not just the worker.
# 0 disables the in-process loop (the worker cron still runs).
FELIX_AUDIT_FLUSH_SECONDS=5
FELIX_OTEL_ENABLED=false
# OTLP collector endpoint used when FELIX_OTEL_ENABLED=true.
# FELIX_OTEL_ENDPOINT=http://localhost:4317
# grpc (port 4317) or http (port 4318, and what a hosted OTLP ingest behind TLS wants).
# FELIX_OTEL_PROTOCOL=grpc
# `k=v,k2=v2`. The only way to authenticate to a collector — e.g.
# FELIX_OTEL_HEADERS=authorization=Basic <base64(public_key:secret_key)>
# FELIX_OTEL_HEADERS=
# Plaintext gRPC. Set false for a TLS collector.
# FELIX_OTEL_INSECURE=true
# Reported as service.name on every span; distinguishes deployments in one backend.
# FELIX_OTEL_SERVICE_NAME=felix
# Head sampling, 0.0-1.0. Every model call is a span, so lower this on busy deployments.
# FELIX_OTEL_SAMPLE_RATIO=1.0
# Put prompts and completions on spans. OFF by default: a tracing backend is an egress
# destination, and span attributes are not covered by governance content screening.
# FELIX_OTEL_CAPTURE_CONTENT=false
# Caller identity on spans: user.id from the auth principal, plus the tenant id. The
# session id (thread) is always emitted; this gates only what can name a person.
# FELIX_OTEL_CAPTURE_IDENTITY=true
# Ship logs over OTLP too, stamped with the trace they came from. Off by default because
# log volume costs money; the observability overlay turns it on.
# FELIX_OTEL_LOGS=false
# Worker-only Prometheus endpoint (0 = off). The worker has no HTTP server otherwise, so
# fibers, flushes and cron sweeps are invisible to a scrape. UNAUTHENTICATED — keep it on
# an internal network and never publish the port.
# FELIX_METRICS_PORT=9100

# --- observability stack (make up-observability) ---
# Ports are loopback-bound like the rest of the compose stack.
# FELIX_GRAFANA_PORT=3000
# FELIX_PROM_PORT=9090
# FELIX_JAEGER_PORT=16686
# FELIX_PROM_RETENTION=7d
# Grafana runs with anonymous admin, which is right for a loopback-bound local stack and
# wrong anywhere else. Set false and pick a password before exposing it.
# FELIX_GRAFANA_ANONYMOUS=true
# FELIX_GRAFANA_PASSWORD=admin
# Minted by scripts/metrics-token.sh: a second API key with NO scopes, used only by the
# Prometheus scrape. Not the operator key — losing it leaks metrics, not write access.
# FELIX_METRICS_SCRAPE_TOKEN=

# --- sending traces to an external OTLP backend ---
# The FELIX_OTEL_* settings above are passed through deploy/docker/compose.yml, so the
# base stack (`make up`) exports to any backend you already run — a collector, a hosted
# vendor, a console you self-host on another host. No overlay, no SDK, no dependency that
# knows the vendor: Felix emits gen_ai.* semantic-convention spans and anything that reads
# OTLP renders them.
#
# The exporter lives behind an extra, so build the image with it:
#   FELIX_DOCKER_EXTRAS=otel
# Without it the process logs one warning and exports nothing; `felix doctor` fails the
# "otel exporter is installed" row, in every environment including development. That row
# answers for the process running it, so ask the container:
#   docker compose exec api felix doctor
#
# Typical hosted ingest (OTLP/HTTP behind TLS, credential in a header):
#   FELIX_OTEL_ENABLED=true
#   FELIX_OTEL_PROTOCOL=http
#   FELIX_OTEL_ENDPOINT=https://ingest.example.com/v1/otel
#   FELIX_OTEL_INSECURE=false
#   FELIX_OTEL_HEADERS=authorization=Basic <base64 of "<public_key>:<secret_key>">
# Name the deployment when several send to one backend:
#   FELIX_OTEL_SERVICE_NAME=felix-prod
#
# Identity is the one that is ON by default: `user.id` and the tenant id reach the backend.
# Right for a collector you run, a decision to make for one you do not —
# FELIX_OTEL_CAPTURE_IDENTITY=false drops them. Prompts are off unless you opt in.
#
# `make up-observability` points api and worker at a local collector instead. It pins the
# whole transport — endpoint, protocol, FELIX_OTEL_INSECURE — and blanks
# FELIX_OTEL_HEADERS, so a hosted-ingest config sitting in this file is not applied to a
# local collector that speaks plaintext gRPC and asks for no credential. Sampling, content
# and logs still come from here. A process has one OTLP destination, so fan out at the
# collector rather than here.

# Reserved: public key for verifying signed policy bundles. Declared in
# Settings but not consumed yet — set nothing until it is wired up.
# FELIX_POLICY_BUNDLE_PUBKEY=
