# Felix environment — copy to .env and fill secrets.
# Generate secrets with: openssl rand -hex 32

# --- runtime ---
FELIX_ENVIRONMENT=development
# Loopback by default. FELIX_AUTH_MODE=none is refused on any other bind, because an
# unauthenticated API reachable off-host exposes PUT /manifests to anyone who can route
# to it. Containers set 0.0.0.0 explicitly and pair it with a real auth mode.
FELIX_HOST=127.0.0.1
FELIX_PORT=8080
FELIX_LOG_LEVEL=INFO
# auto = JSON in production, readable text elsewhere. Every line carries request_id,
# tenant_id and (when OTel is on) trace_id.
# FELIX_LOG_FORMAT=auto
# Only relevant for a non-development environment; it does NOT permit a public bind.
FELIX_ALLOW_INSECURE=true

# --- auth (none | api_key | jwt) ---
# `none` is a loopback-only local-dev mode. `make up` generates an api_key for you.
FELIX_AUTH_MODE=none
# FELIX_AUTH_API_KEYS={"sk-demo":{"tenant_id":"default","sub":"demo","scopes":["audit:read","manifests:write"]}}
# FELIX_JWT_VERIFIERS=self
# FELIX_JWKS_PUBLIC=   # JWKS JSON (openssl / joserfc)
# FELIX_JWKS_PRIVATE=  # PEM for `felix mint-jwt` — openssl genpkey -algorithm Ed25519
# Tenants a JWT may claim (comma-separated). Empty accepts any claimed tenant,
# which is only safe when the IdP is the sole writer of that claim — on Cognito
# `custom:*` attributes are often user-writable.
FELIX_ALLOWED_TENANTS=

# --- HTTP posture ---
# /docs and /openapi.json are behind auth in api_key and jwt modes (they describe every
# route). A browser cannot send the API credential, so reach the reference through an
# authenticating proxy in front of the origin, or set true to serve it anonymously
# (warned at startup outside development).
# FELIX_DOCS_PUBLIC=false
# HSTS on TLS responses only (seconds; 0 disables). The API sets nosniff, DENY, a
# no-referrer policy and no-store on every response, and a CSP on the docs page.
# includeSubDomains pins every sibling of the hostname for the whole max-age; on an
# apex or shared parent hostname turn it off before the first TLS response.
# FELIX_HSTS_MAX_AGE_SECONDS=15552000
# FELIX_HSTS_INCLUDE_SUBDOMAINS=true

# --- request limits ---
# Requests per window per client, applied *before* authentication so failed
# credentials are throttled too. Uses Redis when FELIX_REDIS_URL is reachable,
# degrading to per-process limits (with a loud log) if it is not.
FELIX_RATE_LIMIT=120
FELIX_RATE_LIMIT_WINDOW_SECONDS=60
# Header carrying the real client IP behind a proxy you operate, e.g.
# cf-connecting-ip or x-forwarded-for. EMPTY by default: the header is
# attacker-controlled unless your proxy overwrites it, and trusting it blindly
# lets one client present as unlimited distinct clients.
FELIX_TRUSTED_CLIENT_IP_HEADER=
# FELIX_OAUTH_CACHE_KEY=  # openssl rand -hex 32
# Commands that MCP stdio servers may spawn (comma-separated, exact match on the string
# the manifest supplies or its resolved absolute path). EMPTY = stdio disabled, which is
# the default: manifest-supplied argv is otherwise arbitrary code execution as the API
# process. Example: FELIX_MCP_STDIO_ALLOWED_COMMANDS=/usr/local/bin/uvx,/usr/bin/npx
FELIX_MCP_STDIO_ALLOWED_COMMANDS=
# Container images sandbox tools may run (comma-separated). `spec.sandboxes[].binding`
# is manifest-supplied and reaches `docker run`, so only the built-in
# python:3.14-slim is permitted unless you name more here.
FELIX_SANDBOX_ALLOWED_IMAGES=
# Required for POST /internal/* when auth_mode != none (or production):
# FELIX_CONSUMER_SHARED_SECRET=  # openssl rand -hex 32
# Signing secret for inbound webhooks; resolved through FELIX_SECRETS_BACKEND.
# FELIX_WEBHOOK_SECRET=          # openssl rand -hex 32
# Clients: header X-Felix-Consumer-Secret: <value>

# --- data plane (cloud-agnostic; AWS + GCP first) ---
# openssl rand -hex 32
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
FELIX_DATABASE_URL=postgresql+psycopg://felix:change-me-use-openssl-rand-hex-32@localhost:5432/felix
# Opt-in Postgres row-level security (sets app.tenant_id per transaction).
# Requires migration 0006_tenant_rls to be applied first.
# FELIX_DATABASE_RLS=false
# Required outside development (validate_runtime refuses an empty value): approvals,
# UI prompts and client-tool answers cross from the API to the worker through it. When it
# is configured but down, waiters, steer, thread notifications and session leases fall
# back to an in-process path and each logs a warning once — that fallback does not cross
# processes.
FELIX_REDIS_URL=redis://localhost:6379/0

# Connection pool, per worker process. The ceiling is size + overflow; past it,
# requests queue for FELIX_DB_POOL_TIMEOUT_SECONDS and then fail.
# FELIX_DB_POOL_SIZE=10
# FELIX_DB_MAX_OVERFLOW=20
# FELIX_DB_POOL_TIMEOUT_SECONDS=30
# A round trip per checkout to detect a connection a pooler closed server-side.
# Worth it behind PgBouncer / RDS Proxy / Cloud SQL; wasted against a direct Postgres.
# FELIX_DB_POOL_PRE_PING=true
# psycopg only. A connect to a blackholed host gives up after this many seconds instead
# of the OS default. Every connection presents application_name=felix-<role> to
# pg_stat_activity; each console script stamps its own role (api | worker | scheduler |
# temporal-worker | cli) and this overrides it. There is no statement-timeout setting on
# purpose — a client-side one does not survive PgBouncer — set it on the role:
#   ALTER ROLE felix SET statement_timeout = '30s';   (felix doctor reports what applies)
# FELIX_DB_CONNECT_TIMEOUT_SECONDS=10
# FELIX_PROCESS_ROLE=
# Set false behind a transaction-mode pooler that does not track prepared statements
# itself. psycopg3 auto-prepares after five executions; under transaction pooling the
# sixth lands on a different server connection and fails. PgBouncer >= 1.21 with
# max_prepared_statements > 0 handles this for you; RDS Proxy pins the session instead,
# which defeats multiplexing, so turn this off there.
# FELIX_DB_PREPARED_STATEMENTS=true

# Granian/uvicorn worker processes. One process per core is the usual starting point;
# each carries its own connection pool, so raise this and the pool ceiling together.
# FELIX_WORKERS=1
# HTTP server: listen queue, async runtime threads per worker, how long a worker may
# finish in-flight requests (and flush its audit buffer) on SIGTERM before it is killed
# — the Helm chart sets this from the pod's grace period — and whether a worker that
# dies is respawned (a slow crash loop then shows only in Granian's log).
# FELIX_HTTP_BACKLOG=1024
# FELIX_HTTP_RUNTIME_THREADS=1
# FELIX_GRACEFUL_SHUTDOWN_SECONDS=120
# FELIX_RESPAWN_FAILED_WORKERS=true
# How long a Taskiq task result lives in Valkey/Redis; every cron tick writes one.
# FELIX_TASK_RESULT_TTL_SECONDS=3600

# Object store: s3 (AWS S3 / MinIO) | gcs (GCP) | fs (local dir, small VMs) | memory
FELIX_OBJECT_STORE=fs
# FELIX_OBJECT_STORE_PATH=   # optional; defaults to $FELIX_DATA_DIR/objects
FELIX_CLOUD_PROVIDER=local
# Secrets: env | file | aws | gcp
FELIX_SECRETS_BACKEND=env
# FELIX_SECRETS_DIR=./secrets
# Extra names resolved via backend for output masking (comma-separated)
# FELIX_SECRET_NAMES=
# FELIX_AWS_REGION=us-east-1
# FELIX_GCP_PROJECT=
# FELIX_GCS_BUCKET=

# Docker image extras (comma-separated): aws,gcp,otel,warehouse — leave empty for lean images
# FELIX_DOCKER_EXTRAS=
# Example DuckDB warehouse image: FELIX_DOCKER_EXTRAS=warehouse FELIX_WAREHOUSE=duckdb

# openssl rand -hex 32
MINIO_ROOT_USER=felix
MINIO_ROOT_PASSWORD=change-me-use-openssl-rand-hex-32
FELIX_S3_ENDPOINT=http://localhost:9000
FELIX_S3_ACCESS_KEY=felix
FELIX_S3_SECRET_KEY=change-me-use-openssl-rand-hex-32
FELIX_S3_BUCKET=felix-bundles
FELIX_S3_REGION=us-east-1

# --- models ---
# Cloud keys (optional). Prefer real provider keys — not LangSmith/tracing tokens.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FELIX_ANTHROPIC_API_KEY=
FELIX_OPENAI_API_KEY=
FELIX_OLLAMA_BASE_URL=http://localhost:11434
# FELIX_LITELLM_BASE_URL=
#
# Local-without-cloud: point the default logical id at an Ollama model you have pulled.
# Compose passes these through (see docker-compose.yml). Example:
#   FELIX_DEFAULT_MODEL_ID=llama-3-fast
#   FELIX_MODEL_ROUTES={"llama-3-fast":{"provider":"ollama","model":"qwen2.5-coder:14b"}}
FELIX_DEFAULT_MODEL_ID=claude-sonnet
# FELIX_MODEL_ROUTES=
# Per-provider endpoint and credential, as JSON. The built-in providers have the named
# settings above; a provider added by a plugin cannot, because Settings ignores unknown
# env vars — so this is how an installed provider is given a key at all. An entry here
# also overrides the named field, which is how you point a built-in somewhere else:
#   FELIX_MODEL_PROVIDER_OPTIONS={"anthropic":{"base_url":"https://gateway.internal/v1"}}
# Every option value is masked out of tool output except the ones the provider consumes as
# addressing (base_url, endpoint placeholders, header options), so a credential is redacted
# whatever it is called — and an unrecognised option is redacted too. Do not put a
# credential in base_url: it is exempt by definition and also reaches logs on a connect error.
#   FELIX_MODEL_PROVIDER_OPTIONS={"groq":{"api_key":"gsk_..."}}
# Cloudflare Workers AI puts the account id in the URL path, so it is required; a
# gateway_id is optional and routes the same request through AI Gateway:
#   FELIX_MODEL_PROVIDER_OPTIONS={"workers_ai":{"api_key":"...","account_id":"...","gateway_id":"default"}}
#   FELIX_MODEL_ROUTES={"cf-fast":{"provider":"workers_ai","model":"@cf/meta/llama-3.3-70b-instruct-fp8-fast"}}
# FELIX_MODEL_PROVIDER_OPTIONS=
# Bounds each HTTP request to a model provider. A large tool call — a file's contents as an
# argument — can legitimately take longer than the 120s default, and when it does the request
# fails and takes the run with it. On a streaming call it bounds the gap between chunks, not
# the whole turn. Read and write timeouts are not retried: a retry waits out the identical
# ceiling on identical input. Connect is pinned at 10s and does not scale with this.
# FELIX_MODEL_TIMEOUT_SECONDS=120

# --- durability ---
FELIX_DURABILITY=fibers
# FELIX_TEMPORAL_HOST=localhost:7233
# FELIX_TEMPORAL_NAMESPACE=default
# A fiber step that keeps raising (a store down, a save that cannot land) retries with
# doubling backoff (1m, 2m, 4m, 8m …, capped at 1h) and is marked `dead` after this many
# consecutive failures — fifteen minutes after the first, at the default.
# FELIX_FIBER_MAX_ATTEMPTS=5
# Durable chats (spec.execution.mode: durable) are fibers by default.
# Temporal: uv sync --extra temporal, then `felix temporal-worker`
# (or `felix-temporal-worker`) on task queue felix-fibers.

# --- retention (worker retention_sweep, nightly at 03:00) ---
# Days a row is kept; 0 keeps forever. audit_events, usage_events, fibers + a2a_tasks
# (terminal rows only), and session_events (whole threads, off by default: the event log
# is the chat record). A manifest's governance.retention_days shortens the audit TTL for
# its own rows and never extends it.
# FELIX_AUDIT_RETENTION_DAYS=30
# FELIX_USAGE_RETENTION_DAYS=365
# FELIX_FIBER_RETENTION_DAYS=7
# FELIX_SESSION_RETENTION_DAYS=0

# --- scale-out (multiple api/worker replicas) ---
# Requires Postgres and a shared object store (s3 | gcs | fs on shared storage);
# Settings.validate_runtime() rejects memory/sqlite when this is on.
# FELIX_SCALE_OUT=false
# Identifies this replica in leases and logs.
# FELIX_REPLICA_ID=local

# --- analytics warehouse (append-only spill; Postgres is system of record) ---
# Lean default: none. Recommended: duckdb (uv sync --extra warehouse).
# Scale-out: clickhouse (uv sync --extra warehouse-clickhouse).
# Alternative: doris only if you already run Apache Doris (warehouse-doris).
FELIX_WAREHOUSE=none
# FELIX_WAREHOUSE_PATH=   # duckdb file; default $FELIX_DATA_DIR/warehouse/felix.duckdb
# FELIX_WAREHOUSE_URL=    # clickhouse http://host:8123 | doris mysql://user:pass@host:9030
# FELIX_WAREHOUSE_DATABASE=felix

# --- long-term memory ---
# Dimension of the memory_vectors.embedding pgvector column (HNSW-indexed).
# Fixed at deploy time: changing it is a re-embed of every stored memory, not a
# config flip. Must match whatever embedding model you configure.
# FELIX_MEMORY_EMBEDDING_DIM=768
# Semantic recall backend. `none` (default) costs nothing and needs nothing
# installed — recall still runs its full-text and topic-key channels.
# FELIX_MEMORY_EMBEDDER=none          # none | sentence_transformers | or any registered
#   model provider (openai, ollama, workers_ai, groq, together, …) — /embeddings is part
#   of the same wire format, and resolves through the same provider descriptor.

# --- Web search -------------------------------------------------------------
# Off by default. Search reaches an endpoint you run or pay for, so a deployment
# should not acquire it by upgrading. `searxng` is bundled because it is
# self-hostable and needs no account; anything else is a plugin
# (felix.search.register_search_backend). A manifest opts in with
# spec.search_tools; without a backend the tool binds and reports it is unset,
# rather than silently doing nothing.
# FELIX_SEARCH_BACKEND=none           # none | searxng | any registered backend
# FELIX_SEARCH_URL=                   # e.g. https://searx.example.com — still
#   validated by the egress guard, so an instance in private space is refused.
# FELIX_SEARCH_API_KEY=               # only if your instance requires one
# FELIX_SEARCH_TIMEOUT_SECONDS=15

# --- Document corpus --------------------------------------------------------
# Per-tenant document ceiling for `/documents`. Nothing else caps how many
# documents a `documents:write` credential may ingest — the other limits bound
# one request and one document, not the corpus.
# FELIX_DOCUMENTS_MAX_PER_TENANT=5000

# Extra directory of SKILL.md packages, searched alongside the bundled skills/ dir.
# FELIX_SKILLS_DIR=/opt/felix/skills
# FELIX_MEMORY_EMBEDDING_MODEL=bge-base-en-v1.5
# FELIX_MEMORY_RECALL_LIMIT=8

# --- SSE reconnect ---
# `GET /chat/stream/{thread_id}` tails the session log so a client can reattach after
# a dropped stream. Idle connections close after this long; the client reconnects with
# its Last-Event-ID and loses nothing.
# FELIX_STREAM_RESUME_IDLE_SECONDS=300
# FELIX_STREAM_RESUME_POLL_SECONDS=1
# Ceiling the resume poll decays to after a stream has been quiet for a while. The
# first 30s stay at the floor above, so reattach latency is unaffected.
# FELIX_STREAM_RESUME_POLL_MAX_SECONDS=10

# --- misc ---
FELIX_DEFAULT_MANIFEST=quick
# Where manifests may come from. `store` (default): tenant Postgres version, then the
# bundled YAML, with the write API mounted. `bundled`: only the files baked into the image,
# and the write routes are not registered at all — absent from the app and from
# /openapi.json rather than present and refusing. Flipping an existing deployment drops
# per-tenant auth.inbound tightening and 409s pin_compile threads once; see the README.
# FELIX_MANIFEST_SOURCE=store
FELIX_DATA_DIR=./data
# Optional workspace for AGENTS.md / SYSTEM.md / instruction files. Also the root the
# workspace file tools (list_dir/read_file/write_file/search_files) are confined to — the
# `contributor` manifest points this at a Felix checkout so the agent can edit it.
# FELIX_WORKSPACE_ROOT=.
# FELIX_LOAD_AGENTS_MD=false
# Not a FELIX_ setting: manifests resolve `auth: secret:NAME` through FELIX_SECRETS_BACKEND,
# and the default env backend reads the bare variable. The `contributor` manifest's GitHub
# MCP server wants a fine-grained PAT scoped to the one repository it may open PRs against
# (Contents: write, Pull requests: write).
# GITHUB_MCP_TOKEN=
FELIX_HIBERNATE_AFTER_SECONDS=300
# How often each process drains its audit/usage buffers to Postgres. The agent
# loop emits from the API process, so the API flushes too — not just the worker.
# 0 disables the in-process loop (the worker cron still runs).
FELIX_AUDIT_FLUSH_SECONDS=5
FELIX_OTEL_ENABLED=false
# OTLP collector endpoint used when FELIX_OTEL_ENABLED=true.
# FELIX_OTEL_ENDPOINT=http://localhost:4317
# grpc (port 4317) or http (port 4318, and what a hosted OTLP ingest behind TLS wants).
# FELIX_OTEL_PROTOCOL=grpc
# `k=v,k2=v2`. The only way to authenticate to a collector — e.g.
# FELIX_OTEL_HEADERS=authorization=Basic <base64(public_key:secret_key)>
# FELIX_OTEL_HEADERS=
# Plaintext gRPC. Set false for a TLS collector.
# FELIX_OTEL_INSECURE=true
# Reported as service.name on every span; distinguishes deployments in one backend.
# FELIX_OTEL_SERVICE_NAME=felix
# Head sampling, 0.0-1.0. Every model call is a span, so lower this on busy deployments.
# FELIX_OTEL_SAMPLE_RATIO=1.0
# Put prompts and completions on spans. OFF by default: a tracing backend is an egress
# destination, and span attributes are not covered by governance content screening.
# FELIX_OTEL_CAPTURE_CONTENT=false
# Caller identity on spans: user.id from the auth principal, plus the tenant id. The
# session id (thread) is always emitted; this gates only what can name a person.
# FELIX_OTEL_CAPTURE_IDENTITY=true
# Ship logs over OTLP too, stamped with the trace they came from. Off by default because
# log volume costs money; the observability overlay turns it on.
# FELIX_OTEL_LOGS=false
# Worker-only Prometheus endpoint (0 = off). The worker has no HTTP server otherwise, so
# fibers, flushes and cron sweeps are invisible to a scrape. UNAUTHENTICATED — keep it on
# an internal network and never publish the port.
# FELIX_METRICS_PORT=9100

# --- observability stack (make up-observability) ---
# Ports are loopback-bound like the rest of the compose stack.
# FELIX_GRAFANA_PORT=3000
# FELIX_PROM_PORT=9090
# FELIX_JAEGER_PORT=16686
# FELIX_PROM_RETENTION=7d
# Grafana runs with anonymous admin, which is right for a loopback-bound local stack and
# wrong anywhere else. Set false and pick a password before exposing it.
# FELIX_GRAFANA_ANONYMOUS=true
# FELIX_GRAFANA_PASSWORD=admin
# Minted by scripts/metrics-token.sh: a second API key with NO scopes, used only by the
# Prometheus scrape. Not the operator key — losing it leaks metrics, not write access.
# FELIX_METRICS_SCRAPE_TOKEN=

# --- Memoturn (make up-memoturn) ---
# Memoturn ingests OTLP natively, so Felix needs no SDK — just an endpoint and a header.
# base64 of "<public_key>:<secret_key>" from a Memoturn project's settings:
#   FELIX_MEMOTURN_BASIC_AUTH=$(printf '%s:%s' "$PUBLIC_KEY" "$SECRET_KEY" | base64)
# FELIX_MEMOTURN_BASIC_AUTH=
# Point at a Memoturn you run elsewhere instead of the local overlay.
# FELIX_MEMOTURN_ENDPOINT=http://memoturn-api:3001/v1/otel
# Required by Memoturn's own env validation (openssl rand -base64 48 each).
# MEMOTURN_AUTH_SECRET=
# MEMOTURN_ENCRYPTION_KEY=
# FELIX_MEMOTURN_CONSOLE_PORT=3002
# FELIX_MEMOTURN_API_PORT=3001
# Reserved: public key for verifying signed policy bundles. Declared in
# Settings but not consumed yet — set nothing until it is wired up.
# FELIX_POLICY_BUNDLE_PUBKEY=
